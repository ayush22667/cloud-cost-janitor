{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SnapshotAndDeleteOnlyTaggedVolumes",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateSnapshot",
        "ec2:DeleteVolume",
        "ec2:CreateTags",
        "ec2:DeleteTags"
      ],
      "Resource": "arn:aws:ec2:*:*:volume/*",
      "Condition": { "StringEquals": { "aws:ResourceTag/janitor-demo": "true" } }
    },
    {
      "Sid": "CreateSnapshotNeedsTheSnapshotResourceToo",
      "Effect": "Allow",
      "Action": ["ec2:CreateSnapshot"],
      "Resource": "arn:aws:ec2:*::snapshot/*",
      "Condition": { "StringEquals": { "aws:RequestTag/janitor-demo": "true" } }
    },
    {
      "Sid": "TerminateOnlyTaggedInstances",
      "Effect": "Allow",
      "Action": [
        "ec2:TerminateInstances",
        "ec2:CreateTags",
        "ec2:DeleteTags"
      ],
      "Resource": "arn:aws:ec2:*:*:instance/*",
      "Condition": { "StringEquals": { "aws:ResourceTag/janitor-demo": "true" } }
    },
    {
      "Sid": "TagNewSnapshots",
      "Effect": "Allow",
      "Action": ["ec2:CreateTags"],
      "Resource": "arn:aws:ec2:*::snapshot/*",
      "Condition": { "StringEquals": { "ec2:CreateAction": "CreateSnapshot" } }
    },
    {
      "Sid": "DeleteOnlyTaggedLoadBalancers",
      "Effect": "Allow",
      "Action": [
        "elasticloadbalancing:DeleteLoadBalancer",
        "elasticloadbalancing:AddTags",
        "elasticloadbalancing:RemoveTags"
      ],
      "Resource": "arn:aws:elasticloadbalancing:*:*:loadbalancer/*",
      "Condition": { "StringEquals": { "aws:ResourceTag/janitor-demo": "true" } }
    }
  ]
}
