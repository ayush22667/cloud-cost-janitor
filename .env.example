# Copy to .env and fill in. .env is git-ignored. The server never logs identity or credentials.

# --- MCP auth -------------------------------------------------------------------------------
# Bearer token TrueForge sends to the aws-janitor MCP server. Generate one:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
COST_JANITOR_TOKEN=

# --- AWS identity (exactly one of the two options; there is NO implicit default) -------------
# Option A (recommended): a named profile from ~/.aws (ideally an SSO / IAM Identity Center profile).
AWS_PROFILE=
# Option B (containers / CI): an access-key pair. Discouraged on laptops; prefer a profile.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Audit ANOTHER account without its keys: the identity above assumes this role there (temporary,
# auto-refreshing credentials). Deploy iam/cross-account-role.yaml in that account first.
# AWS_ROLE_ARN=arn:aws:iam::<other-account-id>:role/CloudCostJanitorRole
# AWS_EXTERNAL_ID=

# Regions to scan (comma-separated). Default: us-east-1
AWS_REGIONS=us-east-1

# --- Safety switches --------------------------------------------------------------------------
# false (default) = dry-run: delete_resource reports what it would do and changes nothing.
ALLOW_DELETE=false
# When set, delete_resource refuses any resource that does not carry this tag (key=value).
# iam/janitor-actions-policy.json enforces the same tag at the IAM level.
DELETE_ONLY_TAGGED=janitor-demo=true

# --- Network ------------------------------------------------------------------------------------
# Bind address for the MCP server (TrueForge connects to http://127.0.0.1:8000/mcp)
JANITOR_HOST=127.0.0.1
JANITOR_PORT=8000
