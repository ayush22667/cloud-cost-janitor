# Copy to .env and fill in. .env is git-ignored.

# Bearer token TrueForge sends to the aws-janitor MCP server. Generate one:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
COST_JANITOR_TOKEN=

# Regions to scan (comma-separated). Default: us-east-1
AWS_REGIONS=us-east-1

# AWS credentials are NOT set here. The server uses the standard boto3 credential chain
# (~/.aws/credentials, AWS_PROFILE, env vars). Set AWS_PROFILE if you use a named profile.
# AWS_PROFILE=

# Safety switches
# false (default) = dry-run: delete_resource reports what it would do and changes nothing.
ALLOW_DELETE=false
# When set, delete_resource refuses any resource that does not carry this tag (key=value).
# Recommended during demos so only seeded resources can be removed.
DELETE_ONLY_TAGGED=janitor-demo=true

# Bind address for the MCP server (TrueForge connects to http://127.0.0.1:8000/mcp)
JANITOR_HOST=127.0.0.1
JANITOR_PORT=8000
